rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in users can read or write transactions.
    // Because sign-up is disabled and accounts are created manually
    // (see README), "signed in" already means "one of the household".
    match /transactions/{entryId} {
      allow read, write: if request.auth != null;
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ---------------------------------------------------------------
// OPTIONAL, STRICTER VERSION
// If you'd rather allow-list exact email addresses instead of
// "anyone with an account", replace the transactions block above with:
//
// match /transactions/{entryId} {
//   allow read, write: if request.auth != null &&
//     request.auth.token.email in [
//       'person1@example.com',
//       'person2@example.com'
//     ];
// }
// ---------------------------------------------------------------
